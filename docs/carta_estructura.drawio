        <mxCell id="m6" value="formatear_salida_reporte()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prepara los datos finales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
