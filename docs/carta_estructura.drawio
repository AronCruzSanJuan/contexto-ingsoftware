<mxfile host="app.diagrams.net">
  <diagram id="carta1" name="Carta Estructurada">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="gA" value="Rama Aferente (Entrada)" style="rounded=1;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="560" height="180" as="geometry"/>
