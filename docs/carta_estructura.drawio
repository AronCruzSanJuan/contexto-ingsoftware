        <mxCell id="m5" value="actualizar_estado_incidente()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cambios de estado del reporte&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
