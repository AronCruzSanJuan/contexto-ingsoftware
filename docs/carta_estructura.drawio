        <mxCell id="m1" value="leer_datos_usuario()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;↑ reporte_incidente, numero_folio&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
