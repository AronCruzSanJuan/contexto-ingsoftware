        <mxCell id="gE" value="Rama Eferente (Salida)" style="rounded=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;opacity=50;" vertex="1" parent="1">
