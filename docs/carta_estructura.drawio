        <mxCell id="m3" value="validar_entradas()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;↓ datos crudos&lt;br&gt;↑ datos_validados&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="160" height="90" as="geometry"/>
